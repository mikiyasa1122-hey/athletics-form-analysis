  "requirements": [
    {
      "id": "R1",
      "critical": true,
      "text": "実際の FFmpeg/ffprobe の出力（packets_and_frames 形式、Bフレーム、負のDTS）から原本フレーム索引を正しく作る（FR-TIME-002/003, NFR-TIME-001）",
      "risks": [
        {
          "id": "K1",
          "text": "実ツールの出力形式が想定（packets/frames）と違い読めない、または誤って読む",
          "verifications": [
            {
              "id": "V1",
              "method": "FFmpeg 9.0 の実出力フィクスチャで形式とID・時刻を確認",
              "command": "python3 -m unittest tests.test_real_ffprobe.ManifestExpectationsTest"
            },
            {
              "id": "V2",
              "method": "Bフレーム（復号順パケット・負のDTS）でIDが提示順",
              "command": "python3 -m unittest tests.test_real_ffprobe.DecodeOrderTest"
            }
          ]
        },
        {
          "id": "K2",
          "text": "フィクスチャが実機の出力から離れていく（手で編集・別の版）",
          "verifications": [
            {
              "id": "V3",
              "method": "実機で試験動画を作り直し、ffprobe 出力が保存済みフィクスチャと一致",
              "command": "python3 tools/make_test_videos.py --check"
            }
          ]
        }
      ]
    },
    {
      "id": "R2",
      "critical": true,
      "text": "edit list で再生されない pre-roll パケット（flags D）を原本フレーム・復号失敗に数えず、時刻0を再生の先頭に合わせる（再レビュー N2）",
      "risks": [
        {
          "id": "K3",
          "text": "先頭カットした普通の動画で偽の復号失敗が出る・IDと時刻がずれる",
          "verifications": [
            {
              "id": "V4",
              "method": "実際の先頭カット動画で D パケット9個を除外、復号失敗0、ID・時刻が0から",
              "command": "python3 -m unittest tests.test_real_ffprobe.EditListPrerollTest"
            }
          ]
        }
      ]
    },
    {
      "id": "R3",
      "critical": true,
      "text": "実際に壊れたパケットでデコーダが落としたフレームを、パケットとの差分で復号失敗として検出し、IDを詰めない（FR-TIME-005, NFR-TIME-002）",
      "risks": [
        {
          "id": "K4",
          "text": "実デコーダの振る舞いでは復号失敗が検出できない",
          "verifications": [
            {
              "id": "V5",
              "method": "パケットの中身を壊した実動画で、壊したPTSのIDが復号失敗になり、後ろのIDが詰まらない",
              "command": "python3 -m unittest tests.test_real_ffprobe.RealDecodeFailureTest"
            }
          ]
        }
      ]
    },
    {
      "id": "R4",
      "critical": true,
      "text": "可変FPS（例: 60→30fps）の遅い区間を欠落と誤判定せず、可変FPSとして扱う。本当の欠落は検出する（FR-TIME-003）",
      "risks": [
        {
          "id": "K5",
          "text": "全体の中央値と比べるため、遅い区間が全部「欠落」になり VFR と判定されない",
          "verifications": [
            {
              "id": "V6",
              "method": "実際の60→30fps動画で vfr=True・欠落0、実際の欠落動画で欠落1",
              "command": "python3 -m unittest tests.test_real_ffprobe.ManifestExpectationsTest"
            },
            {
              "id": "V7",
              "method": "既存の合成データの欠落・VFR・異常PTSテストが引き続き通る",
              "command": "python3 -m unittest tests.test_timebase"
            }
          ]
        }
      ]
    },
    {
      "id": "R5",
      "critical": true,
      "text": "実際のコンテナ時刻で端から端まで解析し、イベント区間・接地時間・ピッチの範囲が真値を含む。スロー書き出し（メタデータあり/なし）では秒の値を出さない（AC-012/014/015）",
      "risks": [
        {
          "id": "K6",
          "text": "実際のPTS（time_base 1/15360 など）では区間や値が真値からずれる",
          "verifications": [
            {
              "id": "V8",
              "method": "240fps/可変FPS/欠落/破損の実動画で、全イベント区間と値の範囲が真値を含む",
              "command": "python3 -m unittest tests.test_real_ffprobe.EndToEndOnRealTimingTest"
            }
          ]
        },
        {
          "id": "K7",
          "text": "実際のスロー書き出し動画を実時間として計測する",
          "verifications": [
            {
              "id": "V9",
              "method": "8倍スロー書き出しの実動画（メタデータあり/なし）で接地時間・ピッチが判定不可、角度は有効",
              "command": "python3 -m unittest tests.test_real_ffprobe.EndToEndOnRealTimingTest"
            }
          ]
        }
      ]
    },
    {
      "id": "R6",
      "critical": false,
      "text": "FFmpeg を PATH 反映前でも見つけられる（環境変数 → PATH → winget の既定の場所）",
